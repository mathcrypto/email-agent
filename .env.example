# Copy to .env.local (server loads .env.local then .env)

# Shared secret: server requires Authorization: Bearer <secret> on API routes.
# Baked into the extension at build time — rebuild extension after changing.
LOCAL_API_SECRET=dev-local-secret-change-me

# Required — OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Required — Google OAuth (Web client). Enable Gmail API.
# Consent: email, profile, gmail.readonly (add yourself as test user).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the authorized redirect URI in Google Cloud
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google

APP_BASE_URL=http://localhost:3000
PORT=3000
