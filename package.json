{
  "name": "email-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:ext": "vite --config extension/vite.config.ts",
    "dev:all": "concurrently -n api,ext -c green,cyan \"npm run dev\" \"npm run dev:ext\"",
    "start": "tsx server/index.ts",
    "build:ext": "vite build --config extension/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p extension --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "dotenv": "^16.5.0",
    "googleapis": "^148.0.0",
    "hono": "^4.7.11",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.15.30",
    "concurrently": "^9.2.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5"
  }
}
